# Required — your OpenAI API key (server-side only, never sent to the browser)
OPENAI_API_KEY=

# Set to 1 to run without a key: OpenAI responses are canned (for trying the UI)
OPENAI_MOCK=

# Model that drafts rubrics from a JD (balanced tier by default)
OPENAI_RUBRIC_MODEL=gpt-6.1-sol
# Model behind the Decisions API (only gpt-6-luna is supported in the beta)
OPENAI_DECISION_MODEL=gpt-6-luna

# Answers below this confidence get a "low confidence" badge (0..1)
LOW_CONFIDENCE_THRESHOLD=0.6

# Where roles, rubrics and runs are stored as JSON (gitignored)
DATA_DIR=./data

# Optional: absolute path to a private eval set outside the repo (pnpm eval --private)
PRIVATE_EVAL_DIR=

# Set to 1 to run the live smoke test against the real API
RUN_LIVE=
